      <p class="footer-copy">Copyright &copy; 2025-2026 SnappGrid Studio. All rights reserved. All suspects, crimes, and events are entirely fictitious.</p>
    </div>
  </footer>

  <script>
    function toggleNav() {
      const nav = document.getElementById('navLinks');
      nav.classList.toggle('open');
    }

    let seconds = 0;
    setInterval(() => {
      seconds++;
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      const tElem = document.getElementById('timer');
      if (tElem) tElem.textContent = `${m}:${s}`;
    }, 1000);

    function toggleCell(cell) {
      if (cell.classList.contains('state-x')) {
        cell.classList.remove('state-x');
        cell.classList.add('state-check');
        cell.innerHTML = '&#10004;';
      } else if (cell.classList.contains('state-check')) {
        cell.classList.remove('state-check');
        cell.innerHTML = '';
      } else {
        cell.classList.add('state-x');
        cell.innerHTML = '&times;';
      }
    }

    function verifyVerdict() {
      const culprit = document.getElementById('verdictCulprit').value;
      const weapon = document.getElementById('verdictWeapon').value;
      const location = document.getElementById('verdictLocation').value;
      const time = document.getElementById('verdictTime').value;

      if (!culprit || !weapon || !location || !time) {
        showCustomModal('Incomplete Verdict', 'Please select a value for all four verdict parameters (Culprit, Weapon, Location, and Time) before submitting your case report.');
        return;
      }

      if (culprit === 'Suspect 3' && weapon === 'Poison' && location === 'Library' && time === '9 PM') {
        showCustomModal('CASE CLOSED! 🎉', '<strong>CONGRATULATIONS DETECTIVE!</strong><br><br>Your verdict is 100% correct. You successfully cross-referenced the forensic fingerprint, eliminated the ligature evidence, and pinned Suspect 3 to the Library at 9 PM with Poison!');
      } else {
        showCustomModal('Verdict Rejected ❌', `Your current verdict (<strong>${culprit}</strong> with <strong>${weapon}</strong> in the <strong>${location}</strong> at <strong>${time}</strong>) does not match the evidence.<br><br><em>Detective Hint:</em> Remember that Suspect 3 was in the Garden earlier than Suspect 4, and no Rope evidence was found in the Library!`);
      }
    }

    let currentActionType = '';

    function openPurchaseModal(formatTitle, formatDesc) {
      currentActionType = 'purchase';
      document.getElementById('modalTitle').textContent = `Order ${formatTitle}`;
      document.getElementById('modalBody').innerHTML = `
        <p style="margin-bottom:12px;">You are purchasing the direct download of <strong>The 10-Minute Detective</strong> in <strong>${formatTitle}</strong>.</p>
        <p style="font-size:13.5px; color:var(--ink-soft); background:var(--cream); padding:12px; border-radius:8px; border:1px solid var(--border-strong);">
          ${formatDesc}
        </p>
        <p style="margin-top:12px; font-size:12px; color:var(--ink-muted);">Clicking confirm simulates secure direct checkout and instant digital delivery.</p>
      `;
      document.getElementById('modalConfirmBtn').textContent = 'Complete Order ($4.99)';
      document.getElementById('modalConfirmBtn').style.display = 'inline-flex';
      document.getElementById('customModal').classList.add('visible');
    }

    function openFreeWordDownloadModal() {
      currentActionType = 'free';
      document.getElementById('modalTitle').textContent = 'Free Word File Download 📥';
      document.getElementById('modalBody').innerHTML = `
        <p style="color:var(--green); font-weight:700; margin-bottom:8px;">Limited-Time Promotional Access Active!</p>
        <p style="margin-bottom:12px;">Grab your complimentary copy of <strong>The 10-Minute Detective (Sample Word Edition - Cases #1 to #3)</strong> right now.</p>
        <div style="background:var(--cream); padding:12px; border-radius:8px; border:1px solid var(--border-strong); font-size:13px;">
          <label style="display:block; font-family:'DM Mono',monospace; font-size:11px; margin-bottom:6px; color:var(--ink);">ENTER YOUR EMAIL FOR SECURE DELIVERY:</label>
          <input type="email5" id="freeEmailInput" placeholder="detective@example.com" style="width:100%; padding:8px; border-radius:4px; border:1px solid var(--border-strong); background:var(--white); color:var(--ink);">
        </div>
      `;
      document.getElementById('modalConfirmBtn').textContent = 'Download Free Word File Now';
      document.getElementById('modalConfirmBtn').style.display = 'inline-flex';
      document.getElementById('customModal').classList.add('visible');
    }

    function showCustomModal(title, htmlContent) {
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalBody').innerHTML = htmlContent;
      document.getElementById('modalConfirmBtn').style.display = 'none';
      document.getElementById('customModal').classList.add('visible');
    }

    function closeModal() {
      document.getElementById('customModal').classList.remove('visible');
    }

    function executeCheckout() {
      if (currentActionType === 'free') {
        const email = document.getElementById('freeEmailInput') ? document.getElementById('freeEmailInput').value : '';
        document.getElementById('modalTitle').textContent = 'Success! File Unlocked 🎉';
        document.getElementById('modalBody').innerHTML = `
          <p style="color:var(--green); font-weight:700; margin-bottom:8px;">Your free Word file has been generated!</p>
          <p>We've also queued a backup copy to <strong>${email || 'your email'}</strong>.</p>
          <div style="margin-top:16px; text-align:center;">
            <a href="#" class="btn btn-gold" onclick="closeModal(); return false;">📥 Download Word File (.docx)</a>
          </div>
        `;
        document.getElementById('modalConfirmBtn').style.display = 'none';
      } else {
        document.getElementById('modalTitle').textContent = 'Order Confirmed! 📥';
        document.getElementById('modalBody').innerHTML = `
          <p style="color:var(--green); font-weight:700; margin-bottom:8px;">Thank you for your purchase!</p>
          <p>Your secure download link for the full <strong>Word .docx Master Edition</strong> is ready.</p>
          <div style="margin-top:16px; text-align:center;">
            <a href="#" class="btn btn-gold" onclick="closeModal(); return false;">📥 Download Master .docx Files Now</a>
          </div>
        `;
        document.getElementById('modalConfirmBtn').style.display = 'none';
      }
    }
  </script>
