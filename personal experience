    // Navigation toggle for mobile viewports
    function toggleNav() {
      const nav = document.getElementById('navLinks');
      nav.classList.toggle('open');
    }

    // Live reading timer counter
    let seconds = 0;
    setInterval(() => {
      seconds++;
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      const tElem = document.getElementById('timer');
      if (tElem) tElem.textContent = `${m}:${s}`;
    }, 1000);

    // Interactive Connections Demo logic
    function toggleConnTile(tile) {
      tile.classList.toggle('selected');
    }

    function checkDemoConn() {
      const selectedTiles = Array.from(document.querySelectorAll('#demoConnGrid .conn-tile.selected'));
      const selectedWords = selectedTiles.map(t => t.textContent.trim());
      const computerTerms = ['BYTE', 'CACHE', 'RAM', 'DRIVER'];

      if (selectedWords.length !== 4) {
        showCustomModal('Selection Required', 'Please select exactly 4 tiles to submit your category match.');
        return;
      }

      const isMatch = selectedWords.every(word => computerTerms.includes(word));
      if (isMatch) {
        showCustomModal('Category Solved! 🎉', '<strong>EXCELLENT PATTERN RECOGNITION!</strong><br><br>You identified the <strong>Computer Hardware Terms</strong> category (Byte, Cache, RAM, Driver)!');
      } else {
        showCustomModal('Incorrect Match ❌', 'Those 4 words do not form a clean category set.<br><br><em>Hint:</em> Try separating the computer hardware terms from the types of cheese!');
      }
    }

    // Modal State Management
    function showCustomModal(title, htmlContent) {
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalBody').innerHTML = htmlContent;
      document.getElementById('modalConfirmBtn').style.display = 'none';
      document.getElementById('customModal').classList.add('visible');
    }

    function closeModal() {
      document.getElementById('customModal').classList.remove('visible');
    }
